# Public site origin — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://apsarawallet.com

# Support mailbox surfaced on the Support and Delete Account pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@apsarawallet.com

# Store listing links. Leave blank until the app is published — the download
# buttons render in a disabled "coming soon" state while these are empty.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
