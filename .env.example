# Public site origin — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://wallet.apsara.social

# Support mailbox surfaced on the Support and Delete Account pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@apsara.social

# Store listing links. Leave blank until the app is published — the download
# buttons render in a disabled "coming soon" state while these are empty.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Universal Links (iOS) / App Links (Android) — served from /.well-known.
# Both files 404 until these are set, so a validator fails loudly instead of
# caching a placeholder. Needed at BUILD time (the routes are static).
# Apple Developer Team ID: App Store Connect → Membership.
APPLE_TEAM_ID=
# SHA-256 fingerprint(s) of the Android signing certificate, comma-separated.
# With Play App Signing use the Play-signed cert from Play Console → App
# integrity; add the upload key too for locally-signed release builds:
#   keytool -list -v -keystore ~/apsara-upload-key.jks -alias upload | grep SHA256
ANDROID_CERT_SHA256=
